# OpenRouter API key; leave empty to force degraded mode (llm_config_error)
OPENROUTER_API_KEY=
# OpenRouter model id used for fact extraction
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Set to true to require a bearer token on /score (then API_KEY is required)
AUTH_ENABLED=false
# Bearer token (min 32 chars), only needed when AUTH_ENABLED=true
API_KEY=
# Per-attempt LLM timeout in milliseconds
LLM_TIMEOUT_MS=10000
# Total per-request time budget in milliseconds
REQUEST_BUDGET_MS=25000
# Log level: debug | info | warn | error
LOG_LEVEL=info
##
